
digraph G {
 graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.75, splines=ortho, fontname="DejaVu Sans", labelloc=t, label="ARQUITECTURA EN CAPAS - SISTEMA DE INVENTARIO", fontsize=18];
 node [shape=box, style="rounded,filled", color="#284B63", fillcolor="#F3F7FA", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"];
 edge [color="#526777", penwidth=1.5, arrowsize=0.8, fontname="DejaVu Sans", fontsize=9];
 UI [label="PRESENTACIÓN\nui.py | Tkinter / ttk\nApp, diálogos, ventanas", fillcolor="#E5F0F8"];
